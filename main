    <!-- 3. BEST LEASING OFFERS SECTION -->
    <section id="best-offers-section" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
            <div>
                <div class="flex items-center gap-2 text-blue-600 text-xs font-bold uppercase tracking-widest mb-2">
                    <span class="w-6 h-0.5 bg-blue-600 inline-block"></span>
                    <span>Top Value Picks</span>
                </div>
                <h2 class="text-3xl font-extrabold text-slate-900">Best Leasing Offers</h2>
                <p class="text-sm text-slate-500 mt-1">
                    Automatically ranked by lowest monthly cost against vehicle list price.
                </p>
            </div>

            <!-- Car Offers / Van Offers Switcher -->
            <div class="inline-flex bg-white p-1 rounded-xl border border-slate-200 shadow-sm self-start sm:self-auto">
                <button type="button" id="offers-tab-car" onclick="switchOffersTab('car')"
                    class="px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider bg-blue-600 text-white transition">
                    Car Offers
                </button>
                <button type="button" id="offers-tab-vans" onclick="switchOffersTab('vans')"
                    class="px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider text-slate-600 hover:text-slate-900 transition">
                    Van Offers
                </button>
            </div>
        </div>

        <!-- Offers Grid -->
        <div id="best-offers-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <p class="text-slate-500 text-center col-span-full py-12">Loading best leasing offers...</p>
