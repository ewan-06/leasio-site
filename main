          Compare thousands of personal and business lease deals across the UK. Ranked by real value against list price so you never overpay.
        </p>
      </div>

      <!-- SEARCH BOX (Competitor Style) -->
      <div class="mt-10 border border-border bg-secondary p-6 shadow-2xl">
        <!-- Vehicle Type Tabs -->
        <div class="flex gap-2 border-b border-border pb-4 mb-5">
          <button id="hero-tab-car" type="button" class="px-5 py-2 text-xs font-mono uppercase tracking-widest border border-primary bg-primary text-background font-semibold transition-colors">
            Cars
          </button>
          <button id="hero-tab-vans" type="button" class="px-5 py-2 text-xs font-mono uppercase tracking-widest border border-border bg-background text-muted-foreground hover:text-foreground transition-colors">
            Vans
          </button>
        </div>

        <!-- Filter Dropdowns + Price Slider -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 items-end">
          <div>
            <label for="hero-make" class="block font-mono text-[11px] uppercase tracking-wider text-muted-foreground mb-2">Make</label>
            <select id="hero-make" class="w-full h-11 bg-background border border-border px-3 text-sm text-foreground focus:outline-none focus:border-primary">
              <option value="">Any make</option>
            </select>
          </div>
          <div>
            <label for="hero-model" class="block font-mono text-[11px] uppercase tracking-wider text-muted-foreground mb-2">Model</label>
            <select id="hero-model" disabled class="w-full h-11 bg-background border border-border px-3 text-sm text-foreground disabled:opacity-50 focus:outline-none focus:border-primary">
              <option value="">Select a make first</option>
            </select>
          </div>
          <div>
            <label for="hero-fuel" class="block font-mono text-[11px] uppercase tracking-wider text-muted-foreground mb-2">Fuel Type</label>
            <select id="hero-fuel" class="w-full h-11 bg-background border border-border px-3 text-sm text-foreground focus:outline-none focus:border-primary">
              <option value="">Any fuel type</option>
            </select>
          </div>
          <div class="bg-background border border-border px-3 h-11 flex flex-col justify-center">
            <div class="flex items-center justify-between mb-1">
              <label for="hero-max-price" class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">Max Budget</label>
              <span id="hero-price-label" class="font-mono text-[11px] font-semibold text-primary">Any price</span>
            </div>
            <input 
              type="range" 
              id="hero-max-price" 
              min="150" 
              max="2000" 
              step="50" 
              value="2000" 
              class="w-full h-1 bg-secondary rounded-lg appearance-none cursor-pointer accent-primary"
            />
          </div>
          <div>
            <button id="hero-search-btn" type="button" class="w-full h-11 bg-primary text-background font-semibold text-xs uppercase tracking-widest hover:bg-primary/90 transition-colors flex items-center justify-center gap-2">
              Search Deals &rarr;
            </button>
          </div>
