            <!-- Search Filter Card (Matches the Offer Cards) -->
            <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 border border-slate-200/90 p-6 sm:p-8">
                
                <!-- Cars / Vans Toggle -->
