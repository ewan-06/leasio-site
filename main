  <!-- FOOTER -->
  <footer class="border-t border-border bg-secondary py-10 text-xs text-muted-foreground">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>&copy; 2026 Leasio. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="search.html?type=car" class="hover:text-foreground">Cars</a>
        <a href="search.html?type=vans" class="hover:text-foreground">Vans</a>
      </div>
    </div>
