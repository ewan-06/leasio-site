    <script>
    // Keep your working API_BASE URL here
    const API_BASE = "https://leasio-api.onrender.com"; 
    let currentHeroType = "car";

    function switchHeroVehicleType(type) {
        currentHeroType = type;
        const carBtn = document.getElementById("hero-tab-car");
        const vanBtn = document.getElementById("hero-tab-vans");

        if (type === "car") {
            carBtn.className = "px-5 py-2 rounded-lg text-xs font-bold uppercase tracking-wider bg-blue-600 text-white shadow-sm transition";
            vanBtn.className = "px-5 py-2 rounded-lg text-xs font-bold uppercase tracking-wider bg-slate-100 text-slate-600 hover:bg-slate-200 transition";
        } else {
            vanBtn.className = "px-5 py-2 rounded-lg text-xs font-bold uppercase tracking-wider bg-blue-600 text-white shadow-sm transition";
            carBtn.className = "px-5 py-2 rounded-lg text-xs font-bold uppercase tracking-wider bg-slate-100 text-slate-600 hover:bg-slate-200 transition";
        }

        loadHeroMakes(type);
        loadHeroModels("", type);
        loadHeroFuels("", "", type);
    }

    function switchOffersTab(type) {
        const carTab = document.getElementById("offers-tab-car");
        const vanTab = document.getElementById("offers-tab-vans");

        if (type === "car") {
            carTab.className = "px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider bg-blue-600 text-white transition";
            vanTab.className = "px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider text-slate-600 hover:text-slate-900 transition";
        } else {
            vanTab.className = "px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider bg-blue-600 text-white transition";
            carTab.className = "px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider text-slate-600 hover:text-slate-900 transition";
        }

        loadBestOffers(type);
    }

    // --- 1. HERO SEARCH HELPER FUNCTIONS ---
    async function loadHeroMakes(vehicleType = "car") {
        const makeSelect = document.getElementById("hero-make") || document.getElementById("make-select");
        if (!makeSelect) return;

        try {
            const res = await fetch(`${API_BASE}/api/get_makes?vehicle_type=${encodeURIComponent(vehicleType)}`);
            if (!res.ok) return;
            const data = await res.json();
            const makes = data.makes || [];
            
            makeSelect.innerHTML = '<option value="Any make">Any make</option>';
            makes.forEach(make => {
                const opt = document.createElement("option");
                opt.value = make;
                opt.textContent = make;
                makeSelect.appendChild(opt);
            });
        } catch (err) {
            console.error("Error loading hero makes:", err);
        }
    }

    async function loadHeroModels(selectedMake, vehicleType = "car") {
        const modelSelect = document.getElementById("hero-model") || document.getElementById("model-select");
        if (!modelSelect) return;

        if (!selectedMake || selectedMake === "Any make") {
            modelSelect.innerHTML = '<option value="">Select a make first</option>';
            modelSelect.disabled = true;
            return;
        }

        try {
            const res = await fetch(`${API_BASE}/api/get_models?make=${encodeURIComponent(selectedMake)}&vehicle_type=${encodeURIComponent(vehicleType)}`);
            if (!res.ok) return;
            const data = await res.json();
            const models = data.models || [];
            
            modelSelect.innerHTML = '<option value="">Any model</option>';
            models.forEach(model => {
                const opt = document.createElement("option");
                opt.value = model;
                opt.textContent = model;
                modelSelect.appendChild(opt);
            });
            modelSelect.disabled = false;
        } catch (err) {
            console.error("Error loading hero models:", err);
        }
    }

    async function loadHeroFuels(selectedMake = "", selectedModel = "", vehicleType = "car") {
        const fuelSelect = document.getElementById("hero-fuel") || document.getElementById("fuel-select");
        if (!fuelSelect) return;

        try {
            const params = new URLSearchParams({ vehicle_type: vehicleType });
            if (selectedMake && selectedMake !== "Any make") params.append("make", selectedMake);
            if (selectedModel) params.append("model", selectedModel);

            const res = await fetch(`${API_BASE}/api/get_fuels?${params.toString()}`);
            if (!res.ok) return;
            const data = await res.json();
            const fuels = data.fuels || [];

            fuelSelect.innerHTML = '<option value="Any fuel type">Any fuel type</option>';
            fuels.forEach(fuel => {
                const opt = document.createElement("option");
                opt.value = fuel;
                opt.textContent = fuel;
                fuelSelect.appendChild(opt);
            });
        } catch (err) {
            console.error("Error loading fuels:", err);
        }
    }

    // --- 2. BEST OFFERS FETCHER ---
    async function loadBestOffers(vehicleType = "car") {
        const container = document.getElementById("best-offers-grid");
        if (!container) return;

        container.innerHTML = '<p class="text-slate-500 text-center col-span-full py-12">Loading best leasing offers...</p>';

        try {
            const res = await fetch(`${API_BASE}/api/best_offers?vehicle_type=${encodeURIComponent(vehicleType)}&limit=9`);
            if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);

            const offers = await res.json();
            if (offers.error) throw new Error(offers.error);

            container.innerHTML = "";

            if (!Array.isArray(offers) || offers.length === 0) {
                container.innerHTML = '<p class="text-slate-500 text-center col-span-full py-12">No active offers found.</p>';
                return;
            }

            offers.forEach(offer => {
                const make = offer.Make || "";
                const model = offer.Model || "";
                const derivative = offer.CAP_Derivative || "Standard Spec";
                const fuel = offer.Fuel || "";
                const capCode = offer.CAP_Code || "";
                const monthly = typeof offer.Monthly === "number" ? `£${offer.Monthly.toFixed(2)}` : offer.Monthly;

                const card = document.createElement("div");
                card.className = "bg-white border border-slate-200/90 rounded-2xl shadow-sm hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200 p-6 flex flex-col justify-between";
                card.innerHTML = `
                    <div>
                        <div class="flex justify-between items-start gap-2 mb-1.5">
                            <h3 class="text-lg font-extrabold text-slate-900">${make} ${model}</h3>
                            <span class="bg-blue-50 text-blue-700 border border-blue-100 text-xs font-bold px-2.5 py-0.5 rounded-full whitespace-nowrap">${fuel}</span>
                        </div>
                        <p class="text-sm text-slate-500 mb-6 line-clamp-1">${derivative}</p>
                    </div>
                    <div class="pt-4 border-t border-slate-100 flex justify-between items-end">
                        <div>
                            <span class="text-xs font-medium text-slate-400 block mb-0.5">Monthly Rental</span>
                            <span class="text-2xl font-extrabold text-blue-600">${monthly}</span>
                            <span class="text-xs font-medium text-slate-400"> /mo</span>
                        </div>
                        <a href="/search.html?cap=${encodeURIComponent(capCode)}" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold px-4 py-2.5 rounded-xl shadow-sm shadow-blue-600/20 transition">
                            View Deal
                        </a>
                    </div>
                `;
                container.appendChild(card);
            });
        } catch (err) {
            console.error("Failed to load best offers:", err);
            container.innerHTML = '<p class="text-red-500 text-center col-span-full py-12">Failed to load offers. Please try again shortly.</p>';
        }
    }

    // --- 3. DOM INITIALIZATION ---
    document.addEventListener("DOMContentLoaded", () => {
        loadHeroMakes("car");
        loadHeroFuels("", "", "car");
        loadBestOffers("car");

        const makeSelect = document.getElementById("hero-make");
        const modelSelect = document.getElementById("hero-model");

        if (makeSelect) {
            makeSelect.addEventListener("change", (e) => {
                const selectedMake = e.target.value;
                loadHeroModels(selectedMake, currentHeroType);
                loadHeroFuels(selectedMake, "", currentHeroType);
            });
        }

        if (modelSelect) {
            modelSelect.addEventListener("change", (e) => {
                const selectedMake = makeSelect ? makeSelect.value : "";
                loadHeroFuels(selectedMake, e.target.value, currentHeroType);
            });
        }

        const budgetSlider = document.getElementById("budget-slider");
        const budgetDisplay = document.getElementById("budget-display");
        if (budgetSlider && budgetDisplay) {
            budgetSlider.addEventListener("input", (e) => {
                const val = Number(e.target.value);
                budgetDisplay.textContent = val >= 2000 ? "Any price" : `Up to £${val}/mo`;
            });
        }

        const searchBtn = document.getElementById("hero-search-btn");
        if (searchBtn) {
            searchBtn.addEventListener("click", (e) => {
                e.preventDefault();
                const make = makeSelect ? makeSelect.value : "";
                const model = modelSelect ? modelSelect.value : "";
                const fuelSelect = document.getElementById("hero-fuel");
                const fuel = fuelSelect ? fuelSelect.value : "";
                const budget = budgetSlider ? budgetSlider.value : "";

                const params = new URLSearchParams();
                params.append("type", currentHeroType);
                if (make && make !== "Any make") params.append("make", make);
                if (model) params.append("model", model);
                if (fuel && fuel !== "Any fuel type") params.append("fuel", fuel);
                if (budget && Number(budget) < 2000) params.append("max_price", budget);

                window.location.href = `/search.html?${params.toString()}`;
            });
        }
    });
    </script>
</body>
</html>
