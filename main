                        Cars
                    </button>
                    <button type="button" id="hero-tab-vans" onclick="switchHeroVehicleType('vans')"
                        class="px-5 py-2 rounded-lg text-xs font-bold uppercase tracking-wider bg-slate-100 text-slate-600 hover:bg-slate-200 transition">
                        Vans
