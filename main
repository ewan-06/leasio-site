  <!-- BEST OFFERS SECTION -->
  <section id="best-offers" class="py-16 flex-1">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <div class="flex items-center gap-3 text-primary font-mono text-xs tracking-widest uppercase mb-2">
            <span>&mdash;&mdash;</span>
            <span>Top Value Picks</span>
          </div>
          <h2 class="text-3xl font-bold text-foreground">Best Leasing Offers</h2>
          <p class="mt-1 text-sm text-muted-foreground">
            Automatically ranked by lowest monthly cost against vehicle list price.
          </p>
        </div>

        <!-- Offer Type Toggle -->
        <div class="flex items-center gap-2">
          <button id="offers-tab-car" type="button" class="px-4 py-2 text-xs font-mono uppercase tracking-wider border border-primary text-primary bg-primary/10">
            Car Offers
          </button>
          <button id="offers-tab-vans" type="button" class="px-4 py-2 text-xs font-mono uppercase tracking-wider border border-border text-muted-foreground hover:text-foreground">
            Van Offers
          </button>
        </div>
      </div>

      <!-- BEST OFFERS GRID (Matches search.html exactly) -->
      <div id="best-offers-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
        <p class="text-sm text-muted-foreground col-span-full py-12 text-center">Loading best leasing offers...</p>
      </div>

      <!-- View All CTA -->
      <div class="mt-12 text-center">
        <a id="view-all-link" href="search.html?type=car&sort=price_asc" class="inline-flex items-center gap-2 border border-border bg-secondary px-8 py-3.5 text-xs font-semibold uppercase tracking-widest text-foreground hover:border-primary hover:text-primary transition-colors">
          View All Vehicles &rarr;
        </a>
